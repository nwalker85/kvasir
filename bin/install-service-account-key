#!/usr/bin/env bash
# kvasir install-service-account-key <target> [--ssh-host HOST] [--apply]
#
# Installs the Kvasir-managed service-account public key into the target
# account's host-local ~/.ssh/authorized_keys. FreeIPA remains the identity
# and sudo-policy source; host authorized_keys becomes the SSH auth surface.

set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1091
# shellcheck source=../lib/common.sh
source "${KVASIR_DIR}/lib/common.sh"
# shellcheck disable=SC1091
# shellcheck source=../lib/op.sh
source "${KVASIR_DIR}/lib/op.sh"
# shellcheck disable=SC1091
# shellcheck source=../lib/service-account-key.sh
source "${KVASIR_DIR}/lib/service-account-key.sh"

kvasir::load_env
kvasir::require_cmd ssh op jq ssh-keygen

KVASIR_WANT_HELP=0
TARGET=""
SSH_HOST_OVERRIDE=""
kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"

while (( $# > 0 )); do
  case "$1" in
    --ssh-host)
      SSH_HOST_OVERRIDE="$2"
      shift 2
      ;;
    "") shift ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
      else
        kvasir::die "unexpected arg: $1"
      fi
      shift
      ;;
  esac
done

if (( KVASIR_WANT_HELP )) || [[ -z "$TARGET" ]]; then
  cat <<EOF
Usage: kvasir install-service-account-key <target> [--ssh-host HOST] [--apply]

Installs the host-scoped service account public key into the account's
host-local ~/.ssh/authorized_keys.

  TARGET      host shortname or FQDN used to derive svc-<host>-root
  --ssh-host  optional SSH route/address when TARGET's ssh alias is wrong
  --apply     write authorized_keys (default: dry-run)
EOF
  exit 0
fi

if [[ "$TARGET" == *.* ]]; then
  SHORT="${TARGET%%.*}"
else
  SHORT="$TARGET"
fi

SSH_HOST="${SSH_HOST_OVERRIDE:-$TARGET}"
UID_NAME="svc-${SHORT}-root"
ITEM_TITLE="FreeIPA Root Host ${SHORT}"
KEY_FILE=""

cleanup() {
  [[ -n "${KEY_FILE}" && -f "${KEY_FILE}" ]] && rm -f "${KEY_FILE}"
}
trap cleanup EXIT

SSH_BATCH_OPTS=(
  -o BatchMode=yes
  -o ConnectTimeout="${KVASIR_SSH_CONNECT_TIMEOUT:-10}"
  -o NumberOfPasswordPrompts=0
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
)

op::item_exists "$ITEM_TITLE" "$KVASIR_OP_VAULT" \
  || kvasir::die "missing 1Password item: ${ITEM_TITLE}"

PRIVATE_KEY="$(service_account::read_private_key "$ITEM_TITLE" "$KVASIR_OP_VAULT")" \
  || kvasir::die "could not read private key from ${ITEM_TITLE}"
KEY_FILE="$(service_account::write_private_key_file "$UID_NAME" "$PRIVATE_KEY")"
PUBLIC_KEY="$(service_account::derive_public_key "$KEY_FILE")" \
  || kvasir::die "could not derive public key from ${ITEM_TITLE}"
REMOTE_UID="$(printf '%q' "$UID_NAME")"
REMOTE_PUBKEY="$(printf '%q' "$PUBLIC_KEY")"

SERVICE_SSH_OPTS=( "${SSH_BATCH_OPTS[@]}" -i "$KEY_FILE" -o IdentitiesOnly=yes )

kvasir::log info "service-account-key: target=${SHORT} ssh-host=${SSH_HOST} user=${UID_NAME}"
if kvasir::is_dry_run; then
  kvasir::log warn "DRY-RUN — pass --apply to write authorized_keys"
  kvasir::log info "DRY: ssh ${UID_NAME}@${SSH_HOST} install ~/.ssh/authorized_keys entry"
  exit 0
fi

# shellcheck disable=SC2029
ssh "${SERVICE_SSH_OPTS[@]}" "${UID_NAME}@${SSH_HOST}" "uid=${REMOTE_UID} pubkey=${REMOTE_PUBKEY} bash -s" <<'REMOTE'
set -euo pipefail
home="$(getent passwd "$uid" | cut -d: -f6)"
group="$(id -gn "$uid")"

if [[ -z "$home" ]]; then
  printf 'could not resolve home for %s\n' "$uid" >&2
  exit 1
fi

if [[ ! -d "$home" ]]; then
  sudo -n install -d -o "$uid" -g "$group" -m 700 "$home"
fi

install -d -m 700 "$home/.ssh"
touch "$home/.ssh/authorized_keys"
chmod 600 "$home/.ssh/authorized_keys"
if ! grep -Fxq "$pubkey" "$home/.ssh/authorized_keys"; then
  printf '%s\n' "$pubkey" >>"$home/.ssh/authorized_keys"
fi
chmod 700 "$home/.ssh"
chmod 600 "$home/.ssh/authorized_keys"
REMOTE

kvasir::log info "authorized_keys updated for ${UID_NAME}@${SSH_HOST}"
