#!/usr/bin/env bash
# kvasir add-ssh-key [--fido2 | --pubkey FILE] [--user USER] [--apply]
#
# Registers an SSH public key (FIDO2 or ed25519) on a Kanidm user,
# requests short-lived SSH user certs via Draupnir (askr SSH CA),
# and wires ~/.ssh/config.
#
# --fido2  generate a resident FIDO2 ed25519-sk key on the YubiKey (default)
# --pubkey path to an existing .pub file to upload
# --user   Kanidm username to attach key to (default: $USER)

set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "${KVASIR_DIR}/lib/common.sh"
source "${KVASIR_DIR}/lib/op.sh"
source "${KVASIR_DIR}/lib/kanidm.sh"
source "${KVASIR_DIR}/lib/draupnir.sh"

kvasir::load_env
kvasir::require_cmd ssh ssh-keygen

MODE="fido2" PUBKEY_FILE="" KANIDM_USER="" KEYFILE=""
KVASIR_WANT_HELP=0
kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"
while (( $# > 0 )); do
  case "$1" in
    --fido2)  MODE="fido2"; shift ;;
    --pubkey) MODE="import"; PUBKEY_FILE="$2"; shift 2 ;;
    --user)   KANIDM_USER="$2"; shift 2 ;;
    "")       shift ;;
    *)        kvasir::die "unexpected arg: $1" ;;
  esac
done

[[ -z "$KANIDM_USER" ]] && KANIDM_USER="${USER}"
KEYFILE="${HOME}/.ssh/id_ed25519_sk_yubikey"

if (( KVASIR_WANT_HELP )); then
  cat <<EOF
Usage: kvasir add-ssh-key [--fido2 | --pubkey FILE] [--user USER] [--apply]

Registers an SSH key on a Kanidm user and wires Draupnir SSH cert minting.
EOF
  exit 0
fi

kvasir::log info "user:   ${KANIDM_USER}  mode: ${MODE}"
kvasir::log info "fabric: Kanidm (FIDO2 keys) + Draupnir (short-lived SSH certs)"
kvasir::is_dry_run && kvasir::log warn "DRY-RUN — pass --apply to mutate"

# ---------- 1. Get pubkey ----------
case "$MODE" in
  fido2)
    if [[ -f "$KEYFILE" && -f "${KEYFILE}.pub" ]]; then
      kvasir::log warn "key already exists at ${KEYFILE} — reusing pubkey"
    else
      kvasir::log info "generating FIDO2 ed25519-sk resident key on YubiKey..."
      if kvasir::is_dry_run; then
        kvasir::log info "DRY: ssh-keygen -t ed25519-sk -O resident -O verify-required -f ${KEYFILE}"
      else
        ssh-keygen -t ed25519-sk -O resident -O verify-required -f "${KEYFILE}" -N ""
      fi
    fi
    if [[ -f "${KEYFILE}.pub" ]]; then
      PUBKEY="$(< "${KEYFILE}.pub")"
    else
      PUBKEY="sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAI dummy-fido2-pubkey"
    fi
    ;;
  import)
    [[ ! -f "$PUBKEY_FILE" ]] && kvasir::die "pubkey file not found: $PUBKEY_FILE"
    PUBKEY="$(< "$PUBKEY_FILE")"
    ;;
esac

PUBKEY="${PUBKEY%$'\n'}"

# ---------- 2. Push to Kanidm ----------
kvasir::log info "[1/3] registering pubkey on Kanidm user ${KANIDM_USER}..."
kanidm::add_ssh_key "$KANIDM_USER" "$PUBKEY"

# ---------- 3. Wire Draupnir SSH Cert Minting ----------
kvasir::log info "[2/3] wiring Draupnir short-lived SSH cert minting..."
draupnir::mint_ssh_cert "$KANIDM_USER" "$PUBKEY" "8h"

# ---------- 4. Wire ~/.ssh/config ----------
kvasir::log info "[3/3] configuring ~/.ssh/config..."
SSH_CONFIG="${HOME}/.ssh/config"
MARK_BEGIN="# >>> kvasir Match ${KANIDM_USER} >>>"
MARK_END="# <<< kvasir Match ${KANIDM_USER} <<<"

BLOCK="${MARK_BEGIN}
# Sovereign Identity logins — YubiKey FIDO2 resident key + Draupnir short-lived certs.
Match user ${KANIDM_USER}
  IdentityAgent none
  IdentityFile ${KEYFILE}
  IdentitiesOnly yes
${MARK_END}"

if grep -qF "${MARK_BEGIN}" "${SSH_CONFIG}" 2>/dev/null; then
  kvasir::log warn "ssh config already has kvasir Match block for ${KANIDM_USER} — leaving alone"
else
  if kvasir::is_dry_run; then
    kvasir::log info "DRY: append Match user ${KANIDM_USER} block to ${SSH_CONFIG}"
  else
    printf "\n%s\n" "${BLOCK}" >> "${SSH_CONFIG}"
    kvasir::log info "ssh config updated: ${SSH_CONFIG}"
  fi
fi

kvasir::log info "DONE — ${KANIDM_USER}'s SSH key registered and Draupnir cert minting wired."
