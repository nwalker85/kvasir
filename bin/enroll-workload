#!/usr/bin/env bash
# kvasir enroll workload <name> [--selector unix:user:NAME] [--agent-host HOST] [--install-agent]
#
# Registers a SPIFFE identity with SPIRE. Does not install agents unless asked.
set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${KVASIR_DIR}/lib/common.sh"
# shellcheck source=../lib/pki.sh
source "${KVASIR_DIR}/lib/pki.sh"
# shellcheck source=../lib/spire.sh
source "${KVASIR_DIR}/lib/spire.sh"
# shellcheck source=../lib/op.sh
source "${KVASIR_DIR}/lib/op.sh"
# shellcheck source=../lib/receipt.sh
source "${KVASIR_DIR}/lib/receipt.sh"

kvasir::load_env
pki::defaults

usage() {
  cat <<EOF
Usage: kvasir enroll workload <name> [--selector SEL] [--agent-host HOST]
                            [--install-agent] [--mint-token] [--apply]

Registers a workload with SPIRE under ${KVASIR_SPIRE_TRUST_DOMAIN}.

  NAME             workload path fragment (e.g. audio-app/frigate-recognizer)
  --selector       SPIRE selector (default: unix:user:<name>)
  --agent-host     host whose agent VOUCHES for this workload (default: hrafngud).
                   This decides where the SVID can actually be obtained: an entry
                   parented to hrafngud's agent is unusable by a workload on grani.
  --install-agent  install a SPIRE agent on --agent-host if it has none
  --apply          mutate (default: dry-run)

Join tokens are never printed. Use --mint-token to store one in 1Password.
EOF
}

KVASIR_WANT_HELP=0
NAME=""
SELECTOR=""
AGENT_HOST=""
INSTALL_AGENT=0
MINT_TOKEN=0

kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"
while (( $# > 0 )); do
  case "$1" in
    --selector) SELECTOR="$2"; shift 2 ;;
    --agent-host) AGENT_HOST="$2"; shift 2 ;;
    --install-agent) INSTALL_AGENT=1; shift ;;
    --mint-token) MINT_TOKEN=1; shift ;;
    "") shift ;;
    *) [[ -z "$NAME" ]] && NAME="$1" || kvasir::die "unexpected arg: $1"; shift ;;
  esac
done

if (( KVASIR_WANT_HELP )) || [[ -z "$NAME" ]]; then
  usage
  exit 0
fi

SELECTOR="${SELECTOR:-}"
[[ -z "$SELECTOR" ]] && SELECTOR="unix:user:${NAME}"
# Export BEFORE any plan is rendered, so the dry run shows the parent that apply
# will really use.
if [[ -n "$AGENT_HOST" ]]; then
  export KVASIR_SPIRE_AGENT_HOST="$AGENT_HOST"
  # defaults() already ran at load and froze the parent from the old host; clear
  # the derived value so it is recomputed from the host just named.
  unset KVASIR_SPIRE_AGENT_SPIFFE_ID
  spire::defaults
fi
kvasir::is_dry_run && kvasir::log warn "DRY-RUN — pass --apply to mutate"

pki::issue_plan workload "$NAME"
spire::entry_create_plan "$NAME" "$SELECTOR"
kvasir::log info "selector=${SELECTOR}"

if (( INSTALL_AGENT == 1 )); then
  spire::agent_install_plan
elif ! kvasir::is_dry_run; then
  # Refuse rather than register an identity nobody can obtain.
  if ! spire::agent_installed; then
    kvasir::die "no SPIRE agent on ${KVASIR_SPIRE_AGENT_HOST}: the entry would be \
unusable there. Re-run with --install-agent, or --agent-host a host that has one."
  fi
fi

if kvasir::is_dry_run; then
  spire::preflight
  exit 0
fi

spire::preflight
# The agent comes first: it is the parent the entry names.
if (( INSTALL_AGENT == 1 )); then
  spire::agent_install
fi
spire::entry_create "$NAME" "$SELECTOR"
if (( MINT_TOKEN == 1 )); then
  spire::join_token_mint "$NAME"
fi
