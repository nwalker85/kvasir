#!/usr/bin/env bash
# kvasir verify-service-account <target>
#
# Read-only verification for a host-scoped root-capable service account.
# Proves the host can resolve the FreeIPA user + SSH key, then logs in with
# the 1Password bootstrap key and confirms sudo works non-interactively.

set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1091
# shellcheck source=../lib/common.sh
source "${KVASIR_DIR}/lib/common.sh"
# shellcheck disable=SC1091
# shellcheck source=../lib/op.sh
source "${KVASIR_DIR}/lib/op.sh"
# shellcheck disable=SC1091
# shellcheck source=../lib/service-account-key.sh
source "${KVASIR_DIR}/lib/service-account-key.sh"

kvasir::load_env
kvasir::require_cmd ssh op jq ssh-keygen

KVASIR_WANT_HELP=0
TARGET=""
SSH_HOST_OVERRIDE=""
PROBE_USER=""
kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"

while (( $# > 0 )); do
  case "$1" in
    --ssh-host)
      SSH_HOST_OVERRIDE="$2"
      shift 2
      ;;
    --probe-user)
      PROBE_USER="$2"
      shift 2
      ;;
    "") shift ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
      else
        kvasir::die "unexpected arg: $1"
      fi
      shift
      ;;
  esac
done

if (( KVASIR_WANT_HELP )) || [[ -z "$TARGET" ]]; then
  cat <<EOF
Usage: kvasir verify-service-account <target> [--ssh-host HOST] [--probe-user USER] [--debug]

Verifies the host-scoped root service account for a Linux host without making
FreeIPA or target-host changes.

  TARGET        host shortname or FQDN used to derive svc-<host>-root
  --ssh-host    optional SSH route/address when TARGET's ssh alias is wrong
  --probe-user  optional user for host-side getent and sss probes
EOF
  exit 0
fi

if [[ "$TARGET" == *.* ]]; then
  FQDN="$TARGET"
  SHORT="${TARGET%%.*}"
else
  SHORT="$TARGET"
  FQDN="${TARGET}.${KVASIR_FREEIPA_DOMAIN}"
fi

SSH_HOST="${SSH_HOST_OVERRIDE:-$TARGET}"
PROBE_SSH_TARGET="$SSH_HOST"
if [[ -n "$PROBE_USER" ]]; then
  PROBE_SSH_TARGET="${PROBE_USER}@${SSH_HOST}"
fi
UID_NAME="svc-${SHORT}-root"
ITEM_TITLE="FreeIPA Root Host ${SHORT}"
FAILURES=0
ACTIONS=()
KEY_FILE=""
PUBLIC_KEY=""

cleanup() {
  [[ -n "${KEY_FILE}" && -f "${KEY_FILE}" ]] && rm -f "${KEY_FILE}"
}
trap cleanup EXIT

SSH_BATCH_OPTS=(
  -o BatchMode=yes
  -o ConnectTimeout="${KVASIR_SSH_CONNECT_TIMEOUT:-10}"
  -o NumberOfPasswordPrompts=0
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
)

record_check() {
  local check="$1" result="$2" evidence="$3" action="${4:-}"
  printf '%-34s %-7s %s\n' "$check" "$result" "$evidence"
  if [[ "$result" != "PASS" ]]; then
    FAILURES=$((FAILURES + 1))
    [[ -n "$action" ]] && ACTIONS+=( "$action" )
  fi
}

first_line() {
  sed -e 's/\r$//' -e '/^[[:space:]]*$/d' | head -n 1
}

short_error() {
  local msg="$1"
  msg="$(printf '%s\n' "$msg" \
    | grep -vE '^\*\* WARNING:|^\*\* This session|^\*\* The server may' \
    | first_line)"
  [[ -z "$msg" ]] && msg="command failed"
  if (( ${#msg} > 96 )); then
    msg="${msg:0:93}..."
  fi
  printf '%s' "$msg"
}

printf 'Host: %s\n' "$FQDN"
printf 'Service account: %s\n\n' "$UID_NAME"
printf '%-34s %-7s %s\n' "Check" "Result" "Evidence"

PRIVATE_KEY=""
if op::item_exists "$ITEM_TITLE" "$KVASIR_OP_VAULT"; then
  record_check "1Password item exists" "PASS" "$ITEM_TITLE"
  if ! PRIVATE_KEY="$(service_account::read_private_key "$ITEM_TITLE" "$KVASIR_OP_VAULT")"; then
    PRIVATE_KEY=""
  fi
else
  record_check \
    "1Password item exists" \
    "FAIL" \
    "missing ${ITEM_TITLE}" \
    "rerun kvasir service-account ${SHORT} --apply to create the bootstrap credential item"
fi

SERVICE_SSH_OPTS=()
HOST_PROBE_OPTS=( "${SSH_BATCH_OPTS[@]}" )
if [[ -n "$PRIVATE_KEY" ]]; then
  KEY_FILE="$(service_account::write_private_key_file "$UID_NAME" "$PRIVATE_KEY")"
  if ! PUBLIC_KEY="$(service_account::derive_public_key "$KEY_FILE" 2>/dev/null)"; then
    PUBLIC_KEY=""
  fi
  SERVICE_SSH_OPTS=( "${SSH_BATCH_OPTS[@]}" -i "$KEY_FILE" -o IdentitiesOnly=yes )
  if [[ -z "$PROBE_USER" ]]; then
    PROBE_SSH_TARGET="${UID_NAME}@${SSH_HOST}"
    HOST_PROBE_OPTS=( "${SERVICE_SSH_OPTS[@]}" )
  fi
fi

if SSH_OUT="$(ssh "${HOST_PROBE_OPTS[@]}" "$PROBE_SSH_TARGET" true 2>&1)"; then
  record_check "Target SSH reachable" "PASS" "ssh ${PROBE_SSH_TARGET} true"
else
  record_check \
    "Target SSH reachable" \
    "FAIL" \
    "$(short_error "$SSH_OUT")" \
    "fix tailnet or approved network reachability to ${SSH_HOST} before debugging identity"
fi

# shellcheck disable=SC2029
# shellcheck disable=SC2029
if USER_OUT="$(ssh "${HOST_PROBE_OPTS[@]}" "$PROBE_SSH_TARGET" "getent passwd ${UID_NAME}" 2>&1)"; then
  record_check "FreeIPA/SSSD user resolves" "PASS" "uid/gid returned"
else
  record_check \
    "FreeIPA/SSSD user resolves" \
    "FAIL" \
    "$(short_error "$USER_OUT")" \
    "re-run or repair kvasir enroll-host ${SHORT} --apply, then check SSSD health"
fi

KEY_COUNT=0
# shellcheck disable=SC2029
# shellcheck disable=SC2029
if KEYS_OUT="$(ssh "${HOST_PROBE_OPTS[@]}" "$PROBE_SSH_TARGET" "sss_ssh_authorizedkeys ${UID_NAME}" 2>&1)"; then
  KEY_COUNT="$(printf '%s\n' "$KEYS_OUT" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
  if (( KEY_COUNT > 0 )); then
    if (( KEY_COUNT == 1 )); then
      record_check "SSSD authorized keys resolves" "PASS" "1 key"
    else
      record_check "SSSD authorized keys resolves" "PASS" "${KEY_COUNT} keys"
    fi
  else
    record_check \
      "SSSD authorized keys resolves" \
      "FAIL" \
      "0 keys" \
      "rerun kvasir service-account ${SHORT} --apply, then verify sshd uses sss_ssh_authorizedkeys"
  fi
else
  record_check \
    "SSSD authorized keys resolves" \
    "FAIL" \
    "$(short_error "$KEYS_OUT")" \
    "re-run or repair kvasir enroll-host ${SHORT} --apply, then check SSSD SSH integration"
fi

if [[ -z "$PRIVATE_KEY" ]]; then
  record_check \
    "Service account SSH login" \
    "FAIL" \
    "private key unavailable in 1Password" \
    "inspect ${ITEM_TITLE} in 1Password and confirm its concealed private-key/password field exists"
  record_check \
    "Passwordless sudo" \
    "FAIL" \
    "service account SSH login not proven" \
    "fix service account SSH login before testing sudo -n"
else
  if ID_OUT="$(ssh "${SERVICE_SSH_OPTS[@]}" "${UID_NAME}@${SSH_HOST}" id 2>&1)"; then
    record_check "Service account SSH login" "PASS" "$(printf '%s\n' "$ID_OUT" | first_line)"
  else
    record_check \
      "Service account SSH login" \
      "FAIL" \
      "$(short_error "$ID_OUT")" \
      "verify AuthorizedKeysCommand behavior and the 1Password private key material for ${ITEM_TITLE}"
  fi

  # shellcheck disable=SC2029
  if [[ -z "$PUBLIC_KEY" ]]; then
    record_check \
      "Host authorized_keys contains key" \
      "FAIL" \
      "could not derive public key" \
      "inspect ${ITEM_TITLE} in 1Password and confirm the private key is a valid OpenSSH key"
  elif AUTH_KEYS_OUT="$(printf '%s\n' "$PUBLIC_KEY" | ssh "${SERVICE_SSH_OPTS[@]}" "${UID_NAME}@${SSH_HOST}" "pubkey=\$(cat); home=\$(getent passwd ${UID_NAME} | cut -d: -f6); test -n \"\$home\" && grep -Fxq \"\$pubkey\" \"\$home/.ssh/authorized_keys\"" 2>&1)"; then
    record_check "Host authorized_keys contains key" "PASS" "~${UID_NAME}/.ssh/authorized_keys"
  else
    record_check \
      "Host authorized_keys contains key" \
      "FAIL" \
      "$(short_error "$AUTH_KEYS_OUT")" \
      "run kvasir install-service-account-key ${SHORT} --ssh-host ${SSH_HOST} --apply"
  fi

  if SUDO_OUT="$(ssh "${SERVICE_SSH_OPTS[@]}" "${UID_NAME}@${SSH_HOST}" "sudo -n true" 2>&1)"; then
    record_check "Passwordless sudo" "PASS" "sudo -n true"
  else
    record_check \
      "Passwordless sudo" \
      "FAIL" \
      "$(short_error "$SUDO_OUT")" \
      "rerun kvasir service-account ${SHORT} --apply, then refresh the target SSSD sudo cache"
  fi
fi

if (( ${#ACTIONS[@]} > 0 )); then
  printf '\n'
  seen_actions=""
  for action in "${ACTIONS[@]}"; do
    case "${seen_actions}" in
      *"|${action}|"*) continue ;;
    esac
    printf 'Action: %s\n' "$action"
    seen_actions="${seen_actions}|${action}|"
  done
fi

if (( FAILURES > 0 )); then
  exit 1
fi
