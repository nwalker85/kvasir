#!/usr/bin/env bash
# kvasir enroll-host <ssh-alias-or-fqdn> [--ip <lan-ip>] [--apply]
#
# Sovereign client host enrollment:
# 1. Joins Kanidm for POSIX identity
# 2. Enrolls in FleetDM with osquery agent
# 3. Requests host certificate from Draupnir (askr PKI)
#
# Defaults to --dry-run. Pass --apply to actually mutate.

set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "${KVASIR_DIR}/lib/common.sh"
source "${KVASIR_DIR}/lib/op.sh"
source "${KVASIR_DIR}/lib/kanidm.sh"
source "${KVASIR_DIR}/lib/fleetdm.sh"
source "${KVASIR_DIR}/lib/draupnir.sh"

kvasir::load_env
kvasir::require_cmd ssh ssh-keygen openssl

KVASIR_WANT_HELP=0
TARGET_IP=""
TARGET=""
kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"

while (( $# > 0 )); do
  case "$1" in
    --ip) TARGET_IP="$2"; shift 2 ;;
    "")   shift ;;
    *)    [[ -z "$TARGET" ]] && TARGET="$1" || kvasir::die "unexpected arg: $1"; shift ;;
  esac
done

if (( KVASIR_WANT_HELP )) || [[ -z "$TARGET" ]]; then
  cat <<EOF
Usage: kvasir enroll-host <ssh-alias-or-fqdn> [--ip LAN-IP] [--apply] [--debug]

Enrolls a host into Ravenhelm Sovereign Identity (Kanidm + FleetDM + Draupnir).

  TARGET   ssh alias (preferred) OR fqdn
  --ip     target host LAN IP
  --apply  actually run mutations (default: dry-run)
EOF
  exit 0
fi

# Resolve fqdn + short
if [[ "$TARGET" == *.* ]]; then
  FQDN="$TARGET"; SHORT="${TARGET%%.*}"
else
  SHORT="$TARGET"; FQDN="${TARGET}.ravenmask.net"
fi
SSH_HOST="$TARGET"

kvasir::log info "target:   ssh=${SSH_HOST}  fqdn=${FQDN}  short=${SHORT}"
kvasir::log info "fabric:   Kanidm (POSIX) + FleetDM (osquery) + Draupnir (PKI)"
kvasir::is_dry_run && kvasir::log warn "DRY-RUN — pass --apply to mutate"

# ---------- 1. Probe target ----------
kvasir::log info "[1/4] probing target host..."
if kvasir::is_dry_run; then
  kvasir::log info "DRY: probe ssh connection to ${SSH_HOST}"
else
  ssh -o BatchMode=yes -o ConnectTimeout=10 "${SSH_HOST}" true \
    || kvasir::die "cannot ssh to ${SSH_HOST}"
fi

# Auto-detect LAN IP if not supplied
if [[ -z "$TARGET_IP" ]]; then
  if kvasir::is_dry_run; then
    TARGET_IP="10.10.20.100"
  else
    TARGET_IP="$(ssh "${SSH_HOST}" "hostname -I 2>/dev/null | awk '{print \$1}'" || echo "127.0.0.1")"
  fi
fi
kvasir::log info "  target IP: ${TARGET_IP}"

# ---------- 2. Kanidm POSIX Identity ----------
kvasir::log info "[2/4] configuring Kanidm POSIX identity..."
kanidm::host_create "${SHORT}" "${FQDN}" "${TARGET_IP}"

# ---------- 3. FleetDM Endpoint Enrollment ----------
kvasir::log info "[3/4] enrolling into FleetDM..."
fleetdm::enroll_host "${SSH_HOST}" "${FQDN}"

# ---------- 4. Draupnir Host Certificate ----------
kvasir::log info "[4/4] requesting host certificate from Draupnir..."
draupnir::request_host_cert "${FQDN}" "${TARGET_IP}" "${SHORT},${FQDN}"

kvasir::log info "DONE — ${SHORT} successfully enrolled into sovereign fabric."
exit 0
