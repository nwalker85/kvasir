#!/usr/bin/env bash
# kvasir service-account <target> [--ip <lan-ip>] [--apply]
#
# Creates or refreshes the host-scoped root-capable service account in
# FreeIPA. This updates the user record and sudo rule on every run, and
# creates the initial credential bundle + 1Password item only when needed.

set -euo pipefail

KVASIR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "${KVASIR_DIR}/lib/common.sh"
source "${KVASIR_DIR}/lib/op.sh"
source "${KVASIR_DIR}/lib/freeipa.sh"

kvasir::load_env
kvasir::require_cmd ssh-keygen openssl op

KVASIR_WANT_HELP=0
TARGET_IP=""
TARGET=""
kvasir::parse_common_flags "$@"
set -- "${KVASIR_REMAINING[@]:-}"

while (( $# > 0 )); do
  case "$1" in
    --ip) TARGET_IP="$2"; shift 2 ;;
    "")   shift ;;
    *)    [[ -z "$TARGET" ]] && TARGET="$1" || kvasir::die "unexpected arg: $1"; shift ;;
  esac
done

if (( KVASIR_WANT_HELP )) || [[ -z "$TARGET" ]]; then
  cat <<EOF
Usage: kvasir service-account <target> [--ip LAN-IP] [--apply]

Ensures the host-scoped root service account for a Linux host exists in
FreeIPA. If no 1Password item exists yet, kvasir also issues the initial
SSH key + certificate bundle and stores it for later use.

  TARGET   ssh alias (preferred) or host shortname/FQDN
  --ip     optional LAN IP for the 1Password record
  --apply  actually run mutations (default: dry-run)
EOF
  exit 0
fi

if [[ "$TARGET" == *.* ]]; then
  FQDN="$TARGET"
  SHORT="${TARGET%%.*}"
else
  SHORT="$TARGET"
  FQDN="${TARGET}.${KVASIR_FREEIPA_DOMAIN}"
fi

kvasir::log info "service-account: short=${SHORT} fqdn=${FQDN} lan-ip=${TARGET_IP:-unknown}"
kvasir::is_dry_run && kvasir::log warn "DRY-RUN — pass --apply to mutate"

  kvasir::log info "[1/1] ensuring root-capable service account..."
  ipa::service_account_ensure_root "${SHORT}" "${FQDN}" "${TARGET_IP}"

kvasir::log info "DONE — ${FQDN} service account ensured"
