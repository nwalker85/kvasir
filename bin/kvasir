#!/usr/bin/env bash
# kvasir — entrypoint dispatcher.
#   kvasir enroll-host <target> [...]
#   kvasir service-account <target> [...]
#   kvasir install-service-account-key <target> [...]
#   kvasir verify-service-account <target>
#   kvasir enroll-user <name> <email> --first F --last L
#   kvasir add-ssh-key [--fido2 | --pubkey FILE]
#   kvasir version
set -euo pipefail

# Follow the installed symlink before locating sibling commands. Invoking a
# symlink via ~/.local/bin or /usr/local/bin leaves $0 at the install path;
# resolving BASH_SOURCE keeps the repository's bin/ and lib/ tree together.
KVASIR_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${KVASIR_SOURCE}" ]]; do
  KVASIR_LINK_DIR="$(cd -P "$(dirname "${KVASIR_SOURCE}")" && pwd)"
  KVASIR_SOURCE="$(readlink "${KVASIR_SOURCE}")"
  if [[ "${KVASIR_SOURCE}" != /* ]]; then
    KVASIR_SOURCE="${KVASIR_LINK_DIR}/${KVASIR_SOURCE}"
  fi
done
KVASIR_BIN="$(cd -P "$(dirname "${KVASIR_SOURCE}")" && pwd)"

kvasir::exec_cmd() {
  local script="$1"; shift
  exec "${KVASIR_BIN}/${script}" "$@"
}

kvasir::enroll_help() {
  cat <<EOF
Usage: kvasir enroll <user|host|endpoint|service|workload> [...]

  user       FreeIPA + Zitadel + 1Password identity
  host       FreeIPA realm join (Linux or macOS)
  endpoint   host + pinned trust bundle + endpoint TLS (Rig + Fleet required)
  service    host-scoped IPA root service account
  workload   SPIRE registration (agents not installed unless asked)

Hyphenated aliases (enroll-user, enroll-host, service-account) still work.
Certificate issuance is kvasir cert, not a side effect of enroll host.
EOF
}

case "${1:-}" in
  ""|-h|--help|help)
    cat <<EOF
kvasir — Ravenhelm identity-onboarding automation.

Usage: kvasir <command> [args...]

Enrollment:
  enroll user|host|endpoint|service|workload
  enroll-host, enroll-user, service-account   (stable aliases)

PKI:
  pki-probe [--discover-pin]   read-only Dogtag + step-ca + SPIRE health

Certificates:
  cert issue|renew|revoke|verify|bundle --class user|host|endpoint|service|workload
      Routes to Dogtag, step-ca, or SPIRE. Never holds a CA key.

Other:
  install-service-account-key <target> [--ssh-host HOST] [--bootstrap-user USER] [--apply]
  verify-service-account <target> [--ssh-host HOST] [--probe-user USER]
  add-ssh-key [--fido2 | --pubkey FILE] [--user USER] [--apply]
  receipt get <enrollment-id>
  verify <enrollment-id>
  version

Flags accepted by all commands:
  --apply     actually mutate (default: dry-run)
  --debug     verbose logging
  --quiet     warn+ only
  -h/--help   per-command help

See docs/provisioning-matrix.md and docs/runbook.md.
EOF
    ;;
  version)
    echo "kvasir 0.2.0"
    echo "root: ${KVASIR_BIN%/*}"
    ;;
  enroll)
    shift
    case "${1:-}" in
      ""|-h|--help) kvasir::enroll_help ;;
      user) shift; kvasir::exec_cmd enroll-user "$@" ;;
      host) shift; kvasir::exec_cmd enroll-host "$@" ;;
      endpoint) shift; kvasir::exec_cmd enroll-endpoint "$@" ;;
      service) shift; kvasir::exec_cmd service-account "$@" ;;
      workload) shift; kvasir::exec_cmd enroll-workload "$@" ;;
      *)
        echo "unknown enroll class: ${1}" >&2
        kvasir::enroll_help >&2
        exit 64
        ;;
    esac
    ;;
  cert)
    shift
    kvasir::exec_cmd cert "$@"
    ;;
  receipt)
    shift
    kvasir::exec_cmd receipt "$@"
    ;;
  verify)
    shift
    kvasir::exec_cmd verify "$@"
    ;;
  pki-probe)
    shift
    kvasir::exec_cmd pki-probe "$@"
    ;;
  enroll-host|service-account|install-service-account-key|verify-service-account|enroll-user|add-ssh-key|enroll-endpoint|enroll-workload)
    cmd="$1"; shift
    kvasir::exec_cmd "$cmd" "$@"
    ;;
  *)
    echo "unknown command: $1" >&2
    echo "run 'kvasir help' for usage" >&2
    exit 64
    ;;
esac
