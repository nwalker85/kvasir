# Kvasir — identity onboarding automation defaults.
# Source this file (or export these vars) before running bin/* scripts.
# Copy to ~/.config/kvasir/env or kvasir.env and customize per-environment.

# --- FreeIPA realm ---
KVASIR_FREEIPA_HOST="hrafngud-ts-svc"        # SSH alias of the FreeIPA services host (ravenmask login)
KVASIR_FREEIPA_CONTAINER="freeipa"           # docker container name on that host
KVASIR_FREEIPA_REALM="RAVENHELM.DEV"
KVASIR_FREEIPA_DOMAIN="ravenhelm.dev"
KVASIR_FREEIPA_FQDN="ipa.ravenhelm.dev"      # what clients put in /etc/hosts
KVASIR_FREEIPA_LAN_IP="10.10.20.10"          # LAN IP of host running freeipa (hrafngud on Asgard tier; was 192.168.1.170 pre-CHG-001-r3 cutover)
KVASIR_FREEIPA_TS_IP="100.91.241.52"         # tailscale IP fallback

# --- Zitadel ---
KVASIR_ZITADEL_HOST="auth.ravenhelm.dev"
KVASIR_ZITADEL_ORG_ID="351285410439168009"   # ravenhelm org

# --- 1Password ---
KVASIR_OP_VAULT="ravenmask"
KVASIR_OP_FREEIPA_SERVER_ITEM="FreeIPA Server"
KVASIR_OP_FREEIPA_ADMIN_PASSWORD_FIELD="${KVASIR_OP_FREEIPA_ADMIN_PASSWORD_FIELD:-Directory Manager Password}"
KVASIR_OP_FREEIPA_DM_PASSWORD_FIELD="${KVASIR_OP_FREEIPA_DM_PASSWORD_FIELD:-Directory Manager Password}"
KVASIR_FREEIPA_KINIT_PRINCIPAL="${KVASIR_FREEIPA_KINIT_PRINCIPAL:-admin}"
KVASIR_OP_ZITADEL_SA_ITEM="Zitadel Service Account"

# --- Behavior ---
KVASIR_DRY_RUN="${KVASIR_DRY_RUN:-1}"        # default to dry-run; --apply overrides
KVASIR_LOG_LEVEL="${KVASIR_LOG_LEVEL:-info}" # debug|info|warn|error

# --- Optional: per-host sudo password (1Password) ---
# When the SSH-login user on a target host requires a sudo password (no
# NOPASSWD), set this to a `op://` URI. Kvasir pipes the resolved value to
# `sudo -S` on the remote rather than failing on the password prompt.
#
# Per-host usage (export before running kvasir):
#   export KVASIR_SUDO_PASSWORD_OP="op://ravenmask/vakr ravenhelm sudo/password"
#   kvasir enroll-host vakr --apply
#
# Leave empty if all your targets have NOPASSWD (the default).
KVASIR_SUDO_PASSWORD_OP="${KVASIR_SUDO_PASSWORD_OP:-}"

# --- FreeIPA host docker access ---
# If the FreeIPA host does not allow plain docker socket access for the SSH
# login user, set this to a 1Password secret URI containing the host sudo
# password. Kvasir will use it only for docker exec calls on the FreeIPA host.
KVASIR_FREEIPA_DOCKER_SUDO_PASSWORD_OP="${KVASIR_FREEIPA_DOCKER_SUDO_PASSWORD_OP:-}"

# --- Root service account bootstrap ---
# When enabled, enroll-host also creates a host-scoped root-capable service
# account in FreeIPA, attaches an SSH key + certificate when needed, and adds
# a sudo rule that grants NOPASSWD root on the target host. The standalone
# `kvasir service-account` command always remains available.
KVASIR_CREATE_ROOT_SERVICE_ACCOUNT="${KVASIR_CREATE_ROOT_SERVICE_ACCOUNT:-1}"

# --- PKI (lab throwaway root on hrafngud; not askr) ---
# Pin the live step-ca root SHA-256 before any --apply that trusts it.
KVASIR_STEPCA_URL="${KVASIR_STEPCA_URL:-https://10.10.20.10:9000}"
KVASIR_STEPCA_FINGERPRINT="${KVASIR_STEPCA_FINGERPRINT:-34aca81faae79d53c014ffb4d4693a0c6b585cd437f2fb1f11d464dfd578060e}"
KVASIR_STEPCA_ROOT_CN="${KVASIR_STEPCA_ROOT_CN:-lab-throwaway-20260820}"
KVASIR_STEPCA_ENDPOINT_PROFILE="${KVASIR_STEPCA_ENDPOINT_PROFILE:-endpoint-tls}"

# SPIRE server (same identity host). Agents are not installed by default.
KVASIR_SPIRE_HOST="${KVASIR_SPIRE_HOST:-${KVASIR_FREEIPA_HOST:-hrafngud-ts-svc}}"
KVASIR_SPIRE_CONTAINER="${KVASIR_SPIRE_CONTAINER:-spire-server}"
KVASIR_SPIRE_TRUST_DOMAIN="${KVASIR_SPIRE_TRUST_DOMAIN:-ravenmask.net}"
KVASIR_SPIRE_BIND="${KVASIR_SPIRE_BIND:-10.10.20.10:8081}"
KVASIR_SPIRE_AGENT_SPIFFE_ID="${KVASIR_SPIRE_AGENT_SPIFFE_ID:-spiffe://ravenmask.net/infra/spire-agent/hrafngud}"

# Dogtag profiles used by `kvasir cert issue --class user|host|service`
KVASIR_IPA_USER_CERT_PROFILE="${KVASIR_IPA_USER_CERT_PROFILE:-caIPAserviceCert}"
KVASIR_IPA_HOST_CERT_PROFILE="${KVASIR_IPA_HOST_CERT_PROFILE:-caIPAserviceCert}"

# Endpoint enrollment (fail-closed on --apply if unset)
# KVASIR_RIG_URL=""
# KVASIR_FLEET_URL=""
